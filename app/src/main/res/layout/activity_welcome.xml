<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/slate_50">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center">

        <!-- Welcome Illustration / Avatar Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="120dp"
            android:layout_height="120dp"
            app:cardCornerRadius="60dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/indigo_500">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="24dp"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="@android:color/white"
                android:contentDescription="User Avatar" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvWelcomeGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Welcome back, User!"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/indigo_600"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Ready to manage and collaborate on your household grocery list?"
            android:textSize="15sp"
            android:textColor="@color/slate_600"
            android:gravity="center" />

        <!-- Feature Highlights Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/slate_200">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛒 Real-Time Checklist Sync"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/slate_800" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="🔑 Shareable Room Invite Codes"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/slate_800" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="🔔 Host Approval for Roommate Requests"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/slate_800" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Prominent Get Into App Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGetIntoApp"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="40dp"
            android:text="Get Into App 🚀"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="@color/indigo_500"
            app:cornerRadius="14dp" />

    </LinearLayout>
</ScrollView>
