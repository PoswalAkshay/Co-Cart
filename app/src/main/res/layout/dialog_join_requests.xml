<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pending Roommate Join Requests"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/indigo_600" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Accept or reject roommates requesting to join your household."
        android:textSize="12sp"
        android:textColor="@color/slate_600" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvJoinRequests"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxHeight="300dp" />

</LinearLayout>
